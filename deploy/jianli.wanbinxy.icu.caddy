jianli.wanbinxy.icu {
    reverse_proxy 127.0.0.1:3000 {
        health_uri /api/health
        health_interval 30s
        health_timeout 10s
        health_status 200
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        header_up Host {host}
    }

    encode zstd gzip

    request_body {
        max_size 6MB
    }

    log {
        output file /var/log/caddy/resume-fit-ai.log {
            roll_size 25mb
            roll_keep 5
            roll_keep_for 720h
        }
        format json
        level INFO
    }
}
